# copy to .env and fill in. .env is gitignored.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# pin an exact model string, not an alias. check platform.openai.com/docs/pricing
OPENAI_MODEL=
# used by the LLM judge in style_check.py; can be the same or a cheaper model
OPENAI_JUDGE_MODEL=

# --- local models ---
EMBEDDING_MODEL=BAAI/bge-m3
NLI_MODEL=cross-encoder/nli-deberta-v3-base
DEVICE=cuda

# --- ablation config only ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- database ---
DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor

# --- pipeline ---
RETRIEVAL_TOP_K=5
OFFBOOK_SCORE_THRESHOLD=0.35
VERIFY_ENTAILMENT_THRESHOLD=0.5
VERIFY_SUPPORTED_RATIO=0.8
STYLE_MAX_RETRIES=2
# measured in data/style_guide/style_guide.md section 2
STYLE_MAX_SENTENCE_WORDS=14
STYLE_FK_MIN=3.0
STYLE_FK_MAX=4.5
STYLE_VOCAB_COVERAGE_MIN=0.9
HISTORY_MAX_MESSAGES=8
CONFIG_VERSION=v1

# --- caching ---
LLM_CACHE_DIR=.llm_cache
LLM_CACHE_ENABLED=true

# --- auth ---
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ALLOW_ANONYMOUS=true

# --- eval ---
EVAL_MODE=0
